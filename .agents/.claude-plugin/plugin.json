{
  "name": "keepassbox",
  "description": "Manage KeePass vaults, entries, and TOTP through KeePassBox.",
  "author": {
    "name": "psyb0t",
    "url": "https://github.com/psyb0t"
  },
  "homepage": "https://github.com/psyb0t/docker-keepassbox",
  "license": "GPL-3.0-only",
  "userConfig": {
    "url": {
      "type": "string",
      "title": "KeePassBox MCP URL",
      "description": "Full MCP URL, including /mcp.",
      "required": true
    },
    "token": {
      "type": "string",
      "title": "KeePassBox bearer token",
      "description": "Token for the intended vault owner and scopes.",
      "required": true,
      "sensitive": true
    }
  }
}
