{
  "name": "@psyb0t/keepassbox",
  "version": "0.0.0",
  "mcpName": "io.github.psyb0t/keepassbox",
  "description": "Manage KeePass vaults, entries, and TOTP through KeePassBox.",
  "type": "module",
  "bin": {
    "keepassbox-mcp": "bin/cli.js"
  },
  "files": [
    "bin",
    "index.js",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "license": "GPL-3.0-only",
  "author": "psyb0t",
  "homepage": "https://github.com/psyb0t/docker-keepassbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psyb0t/docker-keepassbox.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mcp-remote": "0.1.38"
  },
  "publishConfig": {
    "access": "public"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2"
    }
  }
}
