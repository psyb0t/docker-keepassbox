{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.psyb0t/keepassbox",
  "title": "KeePassBox",
  "description": "Manage KeePass vaults, entries, and TOTP over MCP.",
  "version": "0.0.0",
  "repository": {
    "url": "https://github.com/psyb0t/docker-keepassbox",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "docker.io/psyb0t/keepassbox:latest",
      "runtimeHint": "docker",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:8000/mcp"
      }
    }
  ]
}
